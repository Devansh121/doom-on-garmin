// Expected values come from the original p_map.c PIT_CheckLine,
// P_CheckPosition and P_TryMove run on the same E1M1 data, see
// test/map_ref.c. The C stubs P_BlockThingsIterator, so here the map's
// things are taken out of the blockmap and only the mobj being moved is
// linked in: only line clipping is compared.

import Toybox.Lang;
import Toybox.Test;

// Links mo into the map on the floor at x, y.
function placeMobj(mo as Number, x as Number, y as Number) as Void {
    PMobj.mobjs_x[mo] = x;
    PMobj.mobjs_y[mo] = y;
    PMapUtl.P_SetThingPosition(mo);
    var sec = PSetup.subsectors_sector[PMobj.mobjs_subsector[mo]];
    PMobj.mobjs_z[mo] = PSetup.sectors_floorheight[sec];
    PMobj.mobjs_floorz[mo] = PSetup.sectors_floorheight[sec];
    PMobj.mobjs_ceilingz[mo] = PSetup.sectors_ceilingheight[sec];
}

(:test)
function testCheckPositionTryMove(logger as Test.Logger) as Boolean {
    initRender();
    Info.Info_Init();
    loadE1M1();

    // A player (radius 16, MF_DROPOFF, has a player) and a former human
    // (radius 20, no player, so ML_BLOCKMONSTERS lines stop it), both 56
    // high, stepping 16 to 128 units in 8 directions from E1M1 thing
    // spots: walls, too-small openings, ceilings too low, steps over 24,
    // dropoffs (monster only), and steps up, down and level that work.
    // Up to six of each outcome per mobj, out of:
    // player: blocked 622, doesn't fit 42, too low 12, step too big 154, dropoff 0, step up 81, step down 274, flat 3231,
    // monster: blocked 1209, doesn't fit 53, too low 10, step too big 190, dropoff 64, step up 77, step down 190, flat 2623,
    var player = PMobj.P_SpawnMobj(0, 0, PMobj.ONFLOORZ, Info.MT_PLAYER);
    PMobj.mobjs_player[player] = 0;
    var monster = PMobj.P_SpawnMobj(0, 0, PMobj.ONFLOORZ, Info.MT_POSSESSED);
    PMapUtl.P_UnsetThingPosition(player);
    PMapUtl.P_UnsetThingPosition(monster);
    var blocklinks = PSetup.blocklinks;
    for (var i = 0; i < blocklinks.size(); i++) {
        blocklinks[i] = -1;
    }

    var moves = [
        // monster?, x, y, newx, newy, P_CheckPosition, P_TryMove, floatok,
        // tmfloorz, tmceilingz, tmdropoffz, numspechit, ceilingline
        [0, 69206016, -236978176, 70254592, -236978176, 1, 1, 1, 0, 4718592, 0, 0, -1],  // flat
        [0, 69206016, -236978176, 70254592, -235929600, 1, 1, 1, 0, 4718592, 0, 0, -1],  // flat
        [0, 69206016, -236978176, 69206016, -235929600, 1, 1, 1, 0, 4718592, 0, 0, -1],  // flat
        [0, 69206016, -236978176, 68157440, -235929600, 1, 1, 1, 0, 4718592, 0, 0, -1],  // flat
        [0, 69206016, -236978176, 68157440, -236978176, 1, 1, 1, 0, 4718592, 0, 0, -1],  // flat
        [0, 69206016, -236978176, 68157440, -238026752, 1, 1, 1, 0, 4718592, 0, 0, -1],  // flat
        [0, 69206016, -236978176, 67108864, -239075328, 0, 0, 0, 0, 4718592, 0, 0, -1],  // blocked
        [0, 69206016, -236978176, 71303168, -239075328, 0, 0, 0, 0, 4718592, 0, 0, -1],  // blocked
        [0, 69206016, -236978176, 69206016, -241172480, 0, 0, 0, 0, 4718592, 0, 0, -1],  // blocked
        [0, 69206016, -236978176, 77594624, -236978176, 0, 0, 0, 0, 4718592, 0, 0, -1],  // blocked
        [0, 69206016, -236978176, 60817408, -236978176, 0, 0, 0, 0, 4718592, 0, 0, -1],  // blocked
        [0, 66060288, -235929600, 57671680, -235929600, 0, 0, 0, 0, 4718592, 0, 0, -1],  // blocked
        [0, 18874368, -203423744, 23068672, -203423744, 1, 1, 1, -524288, 14680064, -524288, 0, -1],  // step down
        [0, 18874368, -203423744, 23068672, -199229440, 1, 1, 1, -524288, 14680064, -524288, 0, -1],  // step down
        [0, 18874368, -203423744, 18874368, -199229440, 1, 1, 1, -524288, 14680064, -524288, 0, -1],  // step down
        [0, 18874368, -203423744, 14680064, -199229440, 1, 1, 1, -524288, 14680064, -524288, 0, -1],  // step down
        [0, 18874368, -203423744, 14680064, -203423744, 1, 1, 1, -524288, 14680064, -524288, 0, -1],  // step down
        [0, 18874368, -203423744, 14680064, -207618048, 1, 1, 1, -524288, 14680064, -524288, 0, -1],  // step down
        [0, 18874368, -203423744, 10485760, -211812352, 1, 0, 1, 5767168, 14680064, 4718592, 0, -1],  // step too big
        [0, 18874368, -220200960, 10485760, -211812352, 1, 0, 1, 5767168, 14680064, 4718592, 0, -1],  // step too big
        [0, 225443840, -227540992, 229638144, -227540992, 1, 1, 1, 6815744, 12058624, 6815744, 0, -1],  // step up
        [0, 225443840, -227540992, 229638144, -223346688, 1, 1, 1, 6815744, 12058624, 6815744, 0, -1],  // step up
        [0, 225443840, -227540992, 221249536, -231735296, 1, 0, 0, 6291456, 6815744, -3145728, 0, 270],  // doesn't fit
        [0, 225443840, -227540992, 225443840, -231735296, 1, 0, 0, 6291456, 6815744, -3145728, 0, -1],  // doesn't fit
        [0, 225443840, -227540992, 233832448, -227540992, 1, 1, 1, 6815744, 12058624, 6815744, 0, -1],  // step up
        [0, 225443840, -227540992, 225443840, -235929600, 1, 0, 1, -3145728, 6815744, -3145728, 0, -1],  // too low
        [0, 220200960, -229638144, 222298112, -231735296, 1, 0, 0, 6291456, 6815744, -3145728, 0, 270],  // doesn't fit
        [0, 220200960, -229638144, 224395264, -233832448, 1, 0, 1, -3145728, 6815744, -3145728, 0, -1],  // too low
        [0, 220200960, -229638144, 228589568, -221249536, 1, 1, 1, 6815744, 12058624, 6815744, 0, -1],  // step up
        [0, 220200960, -229638144, 228589568, -238026752, 1, 0, 1, -3145728, 6815744, -3145728, 0, -1],  // too low
        [0, 190840832, -184549376, 190840832, -176160768, 1, 1, 1, -1048576, 4718592, -1572864, 0, 192],  // step up
        [0, 190840832, -184549376, 182452224, -176160768, 1, 1, 1, -1048576, 4718592, -1048576, 0, -1],  // step up
        [0, 200278016, -234881024, 191889408, -243269632, 1, 0, 0, -1572864, -1572864, -1572864, 0, -1],  // doesn't fit
        [0, 9437184, -205520896, 8388608, -206569472, 1, 0, 1, 6815744, 12582912, -524288, 0, 92],  // step too big
        [0, 9437184, -205520896, 7340032, -205520896, 1, 0, 1, 6815744, 12582912, -524288, 0, 92],  // step too big
        [0, 9437184, -205520896, 7340032, -207618048, 1, 0, 1, 6815744, 12582912, -524288, 0, -1],  // step too big
        [0, 9437184, -205520896, 5242880, -205520896, 1, 0, 1, 6815744, 12582912, -524288, 0, -1],  // step too big
        [0, 197132288, -260046848, 197132288, -264241152, 1, 0, 0, -1572864, -1572864, -1572864, 1, 341],  // doesn't fit
        [0, 201326592, -308281344, 205520896, -304087040, 1, 0, 0, -1572864, -1572864, -1572864, 0, -1],  // doesn't fit
        [0, 223346688, -229638144, 223346688, -233832448, 1, 0, 1, -3145728, 6815744, -3145728, 0, -1],  // too low
        [0, 223346688, -229638144, 227540992, -233832448, 1, 0, 1, -3145728, 6815744, -3145728, 0, -1],  // too low
        [0, 223346688, -229638144, 214958080, -238026752, 1, 0, 1, -3145728, 2097152, -3145728, 0, -1],  // too low
        [1, 69206016, -236978176, 70254592, -236978176, 1, 1, 1, 0, 4718592, 0, 0, -1],  // flat
        [1, 69206016, -236978176, 70254592, -235929600, 1, 1, 1, 0, 4718592, 0, 0, -1],  // flat
        [1, 69206016, -236978176, 69206016, -235929600, 1, 1, 1, 0, 4718592, 0, 0, -1],  // flat
        [1, 69206016, -236978176, 68157440, -235929600, 1, 1, 1, 0, 4718592, 0, 0, -1],  // flat
        [1, 69206016, -236978176, 68157440, -236978176, 1, 1, 1, 0, 4718592, 0, 0, -1],  // flat
        [1, 69206016, -236978176, 68157440, -238026752, 0, 0, 0, 0, 4718592, 0, 0, -1],  // blocked
        [1, 69206016, -236978176, 69206016, -238026752, 1, 1, 1, 0, 4718592, 0, 0, -1],  // flat
        [1, 69206016, -236978176, 70254592, -238026752, 0, 0, 0, 0, 4718592, 0, 0, -1],  // blocked
        [1, 69206016, -236978176, 67108864, -239075328, 0, 0, 0, 0, 4718592, 0, 0, -1],  // blocked
        [1, 69206016, -236978176, 71303168, -239075328, 0, 0, 0, 0, 4718592, 0, 0, -1],  // blocked
        [1, 69206016, -236978176, 69206016, -241172480, 0, 0, 0, 0, 4718592, 0, 0, -1],  // blocked
        [1, 69206016, -236978176, 77594624, -236978176, 0, 0, 0, 0, 4718592, 0, 0, -1],  // blocked
        [1, 18874368, -203423744, 19922944, -203423744, 1, 0, 1, 2621440, 12058624, -524288, 0, -1],  // dropoff
        [1, 18874368, -203423744, 19922944, -202375168, 1, 0, 1, 2621440, 12058624, -524288, 0, -1],  // dropoff
        [1, 18874368, -203423744, 18874368, -202375168, 1, 0, 1, 2621440, 12058624, -524288, 0, -1],  // dropoff
        [1, 18874368, -203423744, 17825792, -202375168, 1, 0, 1, 2621440, 12058624, -524288, 0, -1],  // dropoff
        [1, 18874368, -203423744, 17825792, -203423744, 1, 0, 1, 2621440, 12058624, -524288, 0, -1],  // dropoff
        [1, 18874368, -203423744, 17825792, -204472320, 1, 0, 1, 2621440, 12058624, -524288, 0, -1],  // dropoff
        [1, 18874368, -203423744, 23068672, -203423744, 1, 1, 1, -524288, 14680064, -524288, 0, -1],  // step down
        [1, 18874368, -203423744, 23068672, -199229440, 1, 1, 1, -524288, 14680064, -524288, 0, -1],  // step down
        [1, 18874368, -203423744, 18874368, -199229440, 1, 1, 1, -524288, 14680064, -524288, 0, -1],  // step down
        [1, 18874368, -203423744, 14680064, -199229440, 1, 1, 1, -524288, 14680064, -524288, 0, -1],  // step down
        [1, 18874368, -203423744, 14680064, -203423744, 1, 1, 1, -524288, 14680064, -524288, 0, -1],  // step down
        [1, 18874368, -203423744, 14680064, -207618048, 1, 1, 1, -524288, 14680064, -524288, 0, -1],  // step down
        [1, 18874368, -203423744, 10485760, -211812352, 1, 0, 1, 5767168, 14680064, 4718592, 0, -1],  // step too big
        [1, 18874368, -220200960, 10485760, -211812352, 1, 0, 1, 5767168, 14680064, 4718592, 0, -1],  // step too big
        [1, 225443840, -227540992, 229638144, -227540992, 1, 1, 1, 6815744, 12058624, 6815744, 0, -1],  // step up
        [1, 225443840, -227540992, 229638144, -223346688, 1, 1, 1, 6815744, 12058624, 6815744, 0, -1],  // step up
        [1, 225443840, -227540992, 221249536, -231735296, 1, 0, 0, 6291456, 6815744, -3145728, 0, 270],  // doesn't fit
        [1, 225443840, -227540992, 225443840, -235929600, 1, 0, 1, -3145728, 6815744, -3145728, 0, -1],  // too low
        [1, 220200960, -229638144, 220200960, -231735296, 1, 0, 0, 6291456, 6815744, -3145728, 0, 270],  // doesn't fit
        [1, 220200960, -229638144, 222298112, -231735296, 1, 0, 0, 6291456, 6815744, -3145728, 0, 270],  // doesn't fit
        [1, 220200960, -229638144, 224395264, -229638144, 1, 0, 0, 6291456, 6815744, -3145728, 0, 270],  // doesn't fit
        [1, 220200960, -229638144, 224395264, -233832448, 1, 0, 1, -3145728, 6815744, -3145728, 0, -1],  // too low
        [1, 220200960, -229638144, 228589568, -221249536, 1, 1, 1, 6815744, 12058624, 6815744, 0, -1],  // step up
        [1, 220200960, -229638144, 228589568, -238026752, 1, 0, 1, -3145728, 6815744, -3145728, 0, -1],  // too low
        [1, 190840832, -184549376, 186646528, -180355072, 1, 1, 1, -1048576, 4718592, -1572864, 0, 192],  // step up
        [1, 190840832, -184549376, 190840832, -176160768, 1, 1, 1, -1048576, 4718592, -1572864, 0, 192],  // step up
        [1, 190840832, -184549376, 182452224, -176160768, 1, 1, 1, -1048576, 4718592, -1048576, 0, -1],  // step up
        [1, 9437184, -205520896, 8388608, -206569472, 1, 0, 1, 6815744, 12582912, -524288, 0, 92],  // step too big
        [1, 9437184, -205520896, 7340032, -205520896, 1, 0, 1, 6815744, 12582912, -524288, 0, 92],  // step too big
        [1, 9437184, -205520896, 7340032, -207618048, 1, 0, 1, 6815744, 12582912, -524288, 0, -1],  // step too big
        [1, 9437184, -205520896, 5242880, -205520896, 1, 0, 1, 6815744, 12582912, -524288, 0, -1],  // step too big
        [1, 197132288, -260046848, 195035136, -262144000, 1, 0, 0, -1572864, -1572864, -1572864, 1, 340],  // doesn't fit
        [1, 197132288, -260046848, 197132288, -262144000, 1, 0, 0, -1572864, -1572864, -1572864, 1, 340],  // doesn't fit
        [1, 223346688, -229638144, 227540992, -233832448, 1, 0, 1, -3145728, 6815744, -3145728, 0, -1],  // too low
        [1, 223346688, -229638144, 223346688, -238026752, 1, 0, 1, -3145728, 6815744, -3145728, 0, -1],  // too low
        [1, 150994944, -243269632, 150994944, -251658240, 1, 0, 1, -8912896, -2621440, -8912896, 0, -1]  // too low
    ];
    for (var i = 0; i < moves.size(); i++) {
        var c = moves[i];
        var mo = c[0] == 0 ? player : monster;
        placeMobj(mo, c[1], c[2]);
        var msg = " case " + i;
        var cp = PMap.P_CheckPosition(mo, c[3], c[4]);
        Test.assertEqualMessage(cp ? 1 : 0, c[5], "P_CheckPosition" + msg);
        Test.assertEqualMessage(PMap.tmfloorz, c[8], "tmfloorz" + msg);
        Test.assertEqualMessage(PMap.tmceilingz, c[9], "tmceilingz" + msg);
        Test.assertEqualMessage(PMap.tmdropoffz, c[10], "tmdropoffz" + msg);
        Test.assertEqualMessage(PMap.numspechit, c[11], "numspechit" + msg);
        Test.assertEqualMessage(PMap.ceilingline, c[12], "ceilingline" + msg);

        var tm = PMap.P_TryMove(mo, c[3], c[4]);
        Test.assertEqualMessage(tm ? 1 : 0, c[6], "P_TryMove" + msg);
        Test.assertEqualMessage(PMap.floatok ? 1 : 0, c[7], "floatok" + msg);
        Test.assertEqualMessage(PMap.tmfloorz, c[8], "tmfloorz after P_TryMove" + msg);
        if (tm) {
            Test.assertEqualMessage(PMobj.mobjs_x[mo], c[3], "x" + msg);
            Test.assertEqualMessage(PMobj.mobjs_y[mo], c[4], "y" + msg);
            Test.assertEqualMessage(PMobj.mobjs_floorz[mo], c[8], "floorz" + msg);
            Test.assertEqualMessage(PMobj.mobjs_ceilingz[mo], c[9], "ceilingz" + msg);
        } else {
            Test.assertEqualMessage(PMobj.mobjs_x[mo], c[1], "x unchanged" + msg);
        }
        PMapUtl.P_UnsetThingPosition(mo);
    }
    return true;
}
