// Expected values come from the original p_*.c files built as they are
// over the same E1M1, see test/player_ref.c. Both sides load the level
// (things and specials included), rebirth player 0 at its start and run
// the same scenarios: walking, shooting and a weapon switch with real
// clipping, P_DamageMobj on an armored player until it dies, and item
// pickups.

import Toybox.Lang;
import Toybox.Test;

// One tic of P_Ticker for player 0, like tic() in player_ref.c: the
// player thinks and its mobj moves; the other thinkers aren't run.
function testPlayerTic() as Void {
    PUser.P_PlayerThink(0);
    PMobj.P_MobjThinker(DPlayer.players_mo[0]);
    PTick.leveltime++;
}

// setup_player in player_ref.c: a fresh E1M1 with player 0 reborn at
// its start, the random index back at 0 first.
function testSetupPlayer() as Number {
    initRender();
    Info.Info_Init();
    MRandom.M_ClearRandom();
    DPlayer.playeringame[0] = true;
    DPlayer.players_playerstate[0] = DPlayer.PST_REBORN;
    loadE1M1();
    PTick.leveltime = 0;
    return DPlayer.players_mo[0];
}

// count_mobjs in player_ref.c
function testCountMobjs() as Number {
    var n = 0;
    for (var t = PTick.thinkers_next[0]; t != 0; t = PTick.thinkers_next[t]) {
        if (PTick.thinkers_function[t] == PTick.TF_MOBJ) {
            n++;
        }
    }
    return n;
}

