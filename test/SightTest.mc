// Expected values come from the original p_sight.c run on the same E1M1
// data, see test/map_ref.c.

import Toybox.Lang;
import Toybox.Test;

(:test)
function testCheckSight(logger as Test.Logger) as Boolean {
    initRender();
    Info.Info_Init();
    loadE1M1();

    // A trooper-sized mobj (56 high) on the floor at each of the first 20
    // E1M1 thing spots; every ordered pair is checked. Rejected pairs leave
    // topslope / bottomslope from the previous call, same as the C.
    var things = PSetup.W_LevelData(MapLumps.THINGS);
    var mos = new [20] as Array<Number>;
    for (var i = 0; i < 20; i++) {
        mos[i] = PMobj.P_SpawnMobj(things[i * 5] << 16, things[i * 5 + 1] << 16, PMobj.ONFLOORZ, Info.MT_POSSESSED);
    }
    PSight.sightcounts[0] = 0;
    PSight.sightcounts[1] = 0;

    var sight = [
        // t1, t2, P_CheckSight, topslope, bottomslope
        [0, 1, 1, 917504, -2752512],
        [0, 2, 1, 917504, -2752512],
        [0, 3, 1, 917504, -2752512],
