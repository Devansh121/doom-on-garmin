        [19, 18, 1, 917504, -2752512]
    ];
    // 70 visible, sightcounts 52 328
    var seen = 0;
    for (var i = 0; i < sight.size(); i++) {
        var c = sight[i];
        var r = PSight.P_CheckSight(mos[c[0]], mos[c[1]]);
        Test.assertEqualMessage(r ? 1 : 0, c[2], "P_CheckSight " + c[0] + " " + c[1]);
        Test.assertEqualMessage(PSight.topslope, c[3], "topslope " + c[0] + " " + c[1]);
        Test.assertEqualMessage(PSight.bottomslope, c[4], "bottomslope " + c[0] + " " + c[1]);
        if (r) {
            seen++;
        }
    }
    Test.assertEqual(seen, 70);
    Test.assertEqual(PSight.sightcounts[0], 52);
    Test.assertEqual(PSight.sightcounts[1], 328);
    return true;
}
